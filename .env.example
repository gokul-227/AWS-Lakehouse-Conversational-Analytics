# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3
S3_BUCKET_NAME=lakechat-datasets
S3_FRONTEND_BUCKET=lakechat-frontend

# Athena
ATHENA_DATABASE=lakechat_db
ATHENA_WORKGROUP=lakechat_workgroup
ATHENA_RESULTS_BUCKET=lakechat-athena-results

# DynamoDB
DYNAMODB_DATASETS_TABLE=lakechat-datasets
DYNAMODB_QUERIES_TABLE=lakechat-queries

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development
